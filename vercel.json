{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://pagead2.googlesyndication.com https://inefficientinherent.com; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com https://pagead2.googlesyndication.com https://ep1.adtrafficquality.google https://inefficientinherent.com https://spendsdetachment.com https://*.spendsdetachment.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; frame-src https://pagead2.googlesyndication.com https://inefficientinherent.com https://spendsdetachment.com https://*.spendsdetachment.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com; child-src https://pagead2.googlesyndication.com https://inefficientinherent.com https://spendsdetachment.com https://*.spendsdetachment.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com; img-src 'self' https: data:; font-src 'self' https://fonts.gstatic.com;"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(blog|documentation|research|category|tutorials)/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(about|contact|features|help)/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800"
        }
      ]
    },
    {
      "source": "/assets/js/ads.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.grokexpedia.us"
        }
      ],
      "destination": "https://grokexpedia.us/:path*",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/grokipedia-vs-wikipedia-how-ai-and-community-encyclopedias-differ",
      "destination": "/blog/grokipedia-vs-wikipedia",
      "permanent": true
    },
    {
      "source": "/sitemap",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/sitemap.html",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/cookie-policy",
      "destination": "/cookies",
      "permanent": true
    },
    {
      "source": "/cookie-policy.html",
      "destination": "/cookies",
      "permanent": true
    },
    {
      "source": "/articles/:path*",
      "destination": "/blog/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/grokipedia-2026-whats-new-in-version-2-1",
      "destination": "/blog/grokipedia-2026-whats-new-version-2-1",
      "permanent": true
    },
    {
      "source": "/blog/mobile-app-features-release-date",
      "destination": "/blog/mobile-app-features-and-release-date",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog.html"
    }
  ]
}
